// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProblemVisibility {
  PUBLIC
  CONTEST_ONLY
}

enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
}

enum ContestStatus {
  UPCOMING
  RUNNING
  FINISHED
}

model User {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  name                 String?
  password             String
  rating               Int?
  contributions        Int?
  problems             Problem[]
  role                 UserRole               @default(USER)
  comments             ProblemComment[]
  submissions          Submission[]
  refreshToken         String?
  createdContests      Contest[]
  contestParticipation ContestParticipant[]
  invitedContests      ContestInvitation[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model Problem {
  id                  String                @id @default(cuid())
  title               String
  description         String                @db.Text
  tags                Tag[]
  difficulty          Difficulty            @default(EASY)
  taskDescription     String                @db.Text
  inputDescription    String                @db.Text
  outputDescription   String                @db.Text
  status              ProblemStatus         @default(PENDING)
  author              User                  @relation(fields: [authorId], references: [id])
  authorId            String
  likeNumber          Int                   @default(0)
  submissions         Submission[]
  testcases           Testcase[]
  solution            Solution?
  problemConstrain    ProblemConstrain?
  comments            ProblemComment[]
  contestProblems     ContestProblem[]
  visibility          ProblemVisibility    @default(PUBLIC) // PUBLIC hoặc CONTEST_ONLY
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([visibility, status])
  @@index([authorId])
}

model Submission {
  id              String            @id @default(cuid())
  code            String            @db.Text
  language        Language          @relation(fields: [languageId], references: [id])
  languageId      String
  status          SubmissionStatus  @default(PENDING)
  user            User              @relation(fields: [userId], references: [id])
  userId          String
  problem         Problem           @relation(fields: [problemId], references: [id])
  problemId       String
  consumedTime    Int?
  consumedMemory  Int?
  failedTests     Testcase[]
  contest         Contest?          @relation(fields: [contestId], references: [id])
  contestId       String?           // Nếu submit trong contest
  submittedAt     DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([contestId, userId, problemId, status]) // Cho leaderboard
  @@index([userId, problemId])
  @@index([contestId, submittedAt])
}

model Testcase {
  id          String    @id @default(cuid())
  input       String    @db.Text
  output      String    @db.Text
  problem     Problem   @relation(fields: [problemId], references: [id])
  problemId   String
  isSample    Boolean   @default(false)
  submissions Submission[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Language {
  id          String      @id @default(cuid())
  name        String      @unique
  submissions Submission[]
  solutions   Solution[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Solution {
  id          String   @id @default(cuid())
  code        String   @db.Text
  language    Language @relation(fields: [languageId], references: [id])
  languageId  String
  problem     Problem  @relation(fields: [problemId], references: [id])
  problemId   String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProblemConstrain {
  id          String   @id @default(cuid())
  problem     Problem  @relation(fields: [problemId], references: [id])
  problemId   String   @unique
  memoryLimit Int
  timeLimit   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProblemComment {
  id         String           @id @default(cuid())
  content    String           @db.Text
  user       User             @relation(fields: [userId], references: [id])
  userId     String
  problem    Problem          @relation(fields: [problemId], references: [id])
  problemId  String
  replyTo    ProblemComment?  @relation("ReplyToRelation", fields: [replyToId], references: [id])
  replyToId  String?
  replies    ProblemComment[] @relation("ReplyToRelation")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  problems  Problem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ==================== CONTEST MODELS ====================

model Contest {
  id             String                @id @default(cuid())
  title          String
  description    String                @db.Text
  startTime      DateTime
  endTime        DateTime
  duration       Int                   @default(0)
  status         ContestStatus        @default(UPCOMING)
  isPublic       Boolean               @default(true)
  maxScore       Int                   @default(0)
  createdBy      User                  @relation(fields: [createdById], references: [id])
  createdById    String
  submissions    Submission[]
  problems       ContestProblem[]
  participants   ContestParticipant[]
  invitations    ContestInvitation[]
  isDeleted      Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([isPublic, startTime]) // Filter contest public/upcoming
  @@index([createdById])
}

model ContestProblem {
  id         String   @id @default(cuid())
  contest    Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestId  String
  problem    Problem  @relation(fields: [problemId], references: [id])
  problemId  String
  order      Int
  points     Int      @default(100)
  createdAt  DateTime @default(now())

  @@unique([contestId, problemId])
  @@unique([contestId, order])
  @@index([contestId])
}

model ContestParticipant {
  id            String   @id @default(cuid())
  contest       Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestId     String
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  joinedAt      DateTime @default(now())
  totalScore    Int      @default(0)
  lastSubmitTime DateTime?

  @@unique([contestId, userId])
  @@index([contestId, totalScore, lastSubmitTime])
  @@index([userId])
}

model ContestInvitation {
  id         String   @id @default(cuid())
  contest    Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestId  String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  invitedAt  DateTime @default(now())

  @@unique([contestId, userId])
  @@index([contestId])
  @@index([userId])
}